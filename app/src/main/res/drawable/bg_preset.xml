<?xml version="1.0" encoding="utf-8"?>
<!-- Preset chip. state_selected marks the station that is playing right now. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/cockpit_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/cockpit_surface_alt" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/cockpit_accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/cockpit_surface_alt" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
