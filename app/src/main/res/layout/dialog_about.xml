<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/aboutVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/cockpit_text_primary"
        android:textSize="18sp"
        tools:text="Version 1.0.0" />

    <TextView
        android:id="@+id/aboutRepo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/cockpit_text_dim"
        android:textSize="14sp"
        tools:text="Updates from owner/repo" />

    <TextView
        android:id="@+id/aboutStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/cockpit_accent"
        android:textSize="16sp"
        tools:text="You are on the latest version" />

    <Button
        android:id="@+id/btnCheckUpdates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/about_check_now" />

    <Button
        android:id="@+id/btnCrashLog"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/about_view_crash_log" />

</LinearLayout>
