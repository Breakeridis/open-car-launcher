<?xml version="1.0" encoding="utf-8"?>
<!--
  Three-column landscape cockpit:

    LEFT                      CENTER                       RIGHT
    [1] clock & calendar      [3] circular moving map      [5] phone projection
    [2] FM/AM radio tuner     [4] speed HUD (in the map)   [6] navigation + music
    [7] app dock + all apps                                [8] theme / vehicle / updater

  The map portal is a circle sized by the screen height (dimensionRatio W,1:1); the side
  columns take whatever width is left. The app drawer is a full-screen overlay in this same
  layout rather than a fragment or second activity: opening it is a visibility flip with no
  transaction, no window animation and no risk of the home task stacking.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cockpit_bg">

    <!-- ========================= [3] MAP PORTAL ========================= -->
    <FrameLayout
        android:id="@+id/mapPortal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.minimal.carlauncher.ui.view.CompassBezelView
            android:id="@+id/compassBezel"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.minimal.carlauncher.ui.view.CircleClipLayout
            android:id="@+id/mapClip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/map_bezel_width"
            android:background="@color/cockpit_surface_alt">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Heading readout. Tap toggles heading-up / north-up. -->
            <LinearLayout
                android:id="@+id/headingChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="@dimen/map_hud_inset"
                android:background="@drawable/bg_hud"
                android:clickable="true"
                android:contentDescription="@string/map_orientation_toggle"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textCardinal"
                        style="@style/Text.Gauge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/speed_placeholder"
                        android:textSize="@dimen/cardinal_text"
                        tools:text="NE" />

                    <TextView
                        android:id="@+id/textDegrees"
                        style="@style/Text.Gauge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/cockpit_text_secondary"
                        android:textSize="@dimen/degrees_text"
                        tools:text="43°" />

                    <TextView
                        android:id="@+id/textHeadingSource"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/heading" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textMapMode"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/map_mode_heading" />
            </LinearLayout>

            <!-- In-portal controls, at the widest part of the circle. -->
            <ImageButton
                android:id="@+id/btnMapSearch"
                android:layout_width="@dimen/map_button_size"
                android:layout_height="@dimen/map_button_size"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/map_hud_inset"
                android:background="@drawable/bg_map_button"
                android:contentDescription="@string/map_search_title"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/btnRecenter"
                android:layout_width="@dimen/map_button_size"
                android:layout_height="@dimen/map_button_size"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/map_hud_inset"
                android:background="@drawable/bg_map_button"
                android:contentDescription="@string/map_recenter"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_my_location" />

            <!-- [4] Speed HUD. Tap toggles KM/H <-> MPH. -->
            <LinearLayout
                android:id="@+id/gaugeSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/map_hud_inset"
                android:background="@drawable/bg_hud"
                android:clickable="true"
                android:contentDescription="@string/speed"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="6dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textSpeed"
                        style="@style/Text.Gauge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/speed_placeholder"
                        android:textColor="@color/cockpit_speed"
                        android:textSize="@dimen/speed_text"
                        tools:text="62" />

                    <TextView
                        android:id="@+id/textSpeedUnit"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/unit_kmh"
                        android:textColor="@color/cockpit_text_secondary"
                        android:textSize="@dimen/speed_unit_text" />
                </LinearLayout>

                <!-- Live GPS lock indicator. -->
                <TextView
                    android:id="@+id/textSpeedStatus"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gps_acquiring" />
            </LinearLayout>
        </com.minimal.carlauncher.ui.view.CircleClipLayout>
    </FrameLayout>

    <!-- =========================== LEFT COLUMN =========================== -->
    <LinearLayout
        android:id="@+id/leftColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/screen_padding"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mapPortal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- [1] Clock & calendar. TextClock ticks itself from the system time broadcasts
             (once a second only because the seconds field asks for it). Tap opens alarms. -->
        <LinearLayout
            android:id="@+id/gaugeClock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_gauge"
            android:clickable="true"
            android:contentDescription="@string/clock_open"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/tile_padding">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/clockTime"
                    style="@style/Text.Gauge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="@dimen/clock_text"
                    tools:text="12:47" />

                <TextClock
                    android:id="@+id/clockSeconds"
                    style="@style/Text.Gauge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:format12Hour="ss"
                    android:format24Hour="ss"
                    android:textColor="@color/cockpit_accent"
                    android:textSize="@dimen/clock_seconds_text"
                    tools:text="09" />
            </LinearLayout>

            <TextClock
                android:id="@+id/clockDay"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:format12Hour="EEEE"
                android:format24Hour="EEEE"
                android:textColor="@color/cockpit_accent"
                android:textSize="@dimen/date_text"
                tools:text="TUESDAY" />

            <TextClock
                android:id="@+id/clockDate"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="d MMMM yyyy"
                android:format24Hour="d MMMM yyyy"
                android:textAllCaps="false"
                android:textSize="@dimen/date_text"
                tools:text="16 September 2026" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/gap" />

        <!-- [2] FM/AM radio tuner -->
        <LinearLayout
            android:id="@+id/radioCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.35"
            android:background="@drawable/bg_gauge"
            android:orientation="vertical"
            android:padding="@dimen/tile_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnSeekDown"
                    android:layout_width="@dimen/radio_seek_size"
                    android:layout_height="@dimen/radio_seek_size"
                    android:background="@drawable/bg_seek"
                    android:contentDescription="@string/radio_seek_down"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_remove" />

                <!-- Tap: open the native radio. Long-press: choose which app that is. -->
                <LinearLayout
                    android:id="@+id/radioDisplay"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dock_item"
                    android:clickable="true"
                    android:contentDescription="@string/radio_open"
                    android:focusable="true"
                    android:gravity="center"
                    android:longClickable="true"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/textRadioFreq"
                        style="@style/Text.Gauge"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/radio_freq_height"
                        android:autoSizeMaxTextSize="@dimen/radio_freq_text"
                        android:autoSizeMinTextSize="20sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="@string/radio_no_freq"
                        android:textSize="@dimen/radio_freq_text"
                        tools:text="88.6" />

                    <TextView
                        android:id="@+id/textRadioBand"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/radio_band_fm"
                        android:textColor="@color/cockpit_accent" />

                    <TextView
                        android:id="@+id/textRadioStation"
                        style="@style/Text.Gauge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:textSize="@dimen/radio_station_text"
                        android:visibility="gone"
                        tools:text="RADIO NOVA"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/textRadioText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:singleLine="true"
                        android:textColor="@color/cockpit_text_dim"
                        android:textSize="@dimen/radio_rt_text"
                        android:visibility="gone"
                        tools:text="Now playing: Daft Punk"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/textRadioStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/radio_grant_access"
                        android:textColor="@color/cockpit_warn"
                        android:textSize="@dimen/radio_rt_text" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSeekUp"
                    android:layout_width="@dimen/radio_seek_size"
                    android:layout_height="@dimen/radio_seek_size"
                    android:background="@drawable/bg_seek"
                    android:contentDescription="@string/radio_seek_up"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add" />
            </LinearLayout>

            <!-- Presets: tap to tune, long-press to store the current station. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/radio_preset_height"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/preset1"
                    style="@style/Text.RadioPreset"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/preset2"
                    style="@style/Text.RadioPreset"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/preset3"
                    style="@style/Text.RadioPreset"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/preset4"
                    style="@style/Text.RadioPreset" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/gap" />

        <!-- [7] App dock + All Apps -->
        <include
            android:id="@+id/dockStrip"
            layout="@layout/view_dock"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dock_height" />
    </LinearLayout>

    <!-- =========================== RIGHT COLUMN ========================== -->
    <LinearLayout
        android:id="@+id/rightColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/screen_padding"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mapPortal"
        app:layout_constraintTop_toTopOf="parent">

        <!-- [5] Phone projection -->
        <LinearLayout
            android:id="@+id/cardProjection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/tile_padding">

            <ImageView
                android:id="@+id/iconProjection"
                android:layout_width="@dimen/card_icon_large"
                android:layout_height="@dimen/card_icon_large"
                android:contentDescription="@null"
                android:src="@drawable/ic_phone_link" />

            <TextView
                android:id="@+id/titleProjection"
                style="@style/Text.Gauge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center"
                android:text="@string/card_projection"
                android:textSize="@dimen/card_label_text" />

            <TextView
                android:id="@+id/subtitleProjection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/projection_hint"
                android:textColor="@color/cockpit_text_dim"
                android:textSize="@dimen/card_sub_text" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/gap" />

        <!-- [6] Navigation + music -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardNav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/tile_padding">

                <ImageView
                    android:id="@+id/iconNav"
                    android:layout_width="@dimen/card_icon"
                    android:layout_height="@dimen/card_icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_navigation" />

                <TextView
                    android:id="@+id/titleNav"
                    style="@style/Text.Gauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:text="@string/card_navigation"
                    android:textSize="@dimen/card_label_text" />

                <TextView
                    android:id="@+id/subtitleNav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="@string/card_not_set"
                    android:textColor="@color/cockpit_text_dim"
                    android:textSize="@dimen/card_sub_text" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/gap"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/cardMusic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/tile_padding">

                <ImageView
                    android:id="@+id/iconMusic"
                    android:layout_width="@dimen/card_icon"
                    android:layout_height="@dimen/card_icon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music" />

                <TextView
                    android:id="@+id/titleMusic"
                    style="@style/Text.Gauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:text="@string/card_music"
                    android:textSize="@dimen/card_label_text" />

                <TextView
                    android:id="@+id/subtitleMusic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="@string/card_not_set"
                    android:textColor="@color/cockpit_text_dim"
                    android:textSize="@dimen/card_sub_text" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/gap" />

        <!-- [8] System controls: theme, vehicle settings, updater -->
        <LinearLayout
            android:id="@+id/systemDock"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dock_height"
            android:background="@drawable/bg_dock"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnTheme"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_item"
                android:contentDescription="@string/dock_theme"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_theme" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_item"
                android:contentDescription="@string/dock_settings"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btnAbout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dock_item"
                    android:contentDescription="@string/dock_updates"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_update" />

                <View
                    android:id="@+id/updateBadge"
                    android:layout_width="@dimen/badge_size"
                    android:layout_height="@dimen/badge_size"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/badge_dot"
                    android:contentDescription="@string/update_available_badge"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============================== DRAWER ============================== -->
    <!-- Full screen and last in the file, so it draws above the map. -->
    <LinearLayout
        android:id="@+id/drawerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/cockpit_scrim"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:autofillHints=""
                    android:background="@null"
                    android:hint="@string/search_apps"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    android:singleLine="true"
                    android:textColor="@color/cockpit_text_primary"
                    android:textColorHint="@color/cockpit_text_dim"
                    android:textSize="@dimen/search_text" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseDrawer"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dock_item"
                android:contentDescription="@string/close_drawer"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/drawerEmpty"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/loading_apps"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
