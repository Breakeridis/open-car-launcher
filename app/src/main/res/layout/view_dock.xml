<?xml version="1.0" encoding="utf-8"?>
<!--
  [7] Bottom-left dock: the fixed All Apps button plus the user-assignable slots. Items share
  the column width equally, so the dock fits whatever width the side column ends up with.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dock_height"
    android:background="@drawable/bg_dock"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageButton
        android:id="@+id/btnAllApps"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_dock_item"
        android:contentDescription="@string/dock_all_apps"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_apps" />

    <View
        android:layout_width="1dp"
        android:layout_height="40dp"
        android:background="@color/cockpit_divider" />

    <!-- User-assignable slots, inflated from item_dock.xml by DockController. -->
    <LinearLayout
        android:id="@+id/dockSlots"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

</LinearLayout>
