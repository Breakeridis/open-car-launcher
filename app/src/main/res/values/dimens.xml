<?xml version="1.0" encoding="utf-8"?>
<!--
  Three-column cockpit sizing.

  The target is the Allwinner T507 / A133 (NWD K2401P platform) 1080p landscape panel. What
  that becomes in dp depends on the ROM's lcd_density, so there are three buckets:
    values/          fallback, ~1024x600 dp (side columns ~200 dp wide)
    values-sw720dp/  1920x1080 at 240 dpi = 1280x720 dp (side columns ~265 dp) - the usual case
    values-sw1000dp/ 1920x1080 at 160 dpi = 1920x1080 dp (side columns ~400 dp)
  The map portal is always a circle sized by the screen height; the side columns share the rest.
-->
<resources>
    <dimen name="screen_padding">12dp</dimen>
    <dimen name="gap">10dp</dimen>
    <dimen name="corner">16dp</dimen>
    <dimen name="tile_padding">10dp</dimen>

    <!-- [1] clock -->
    <dimen name="clock_text">52sp</dimen>
    <dimen name="clock_seconds_text">20sp</dimen>
    <dimen name="date_text">15sp</dimen>
    <dimen name="gauge_caption_text">12sp</dimen>

    <!-- [2] radio -->
    <dimen name="radio_freq_text">44sp</dimen>
    <dimen name="radio_freq_height">52dp</dimen>
    <dimen name="radio_station_text">16sp</dimen>
    <dimen name="radio_rt_text">13sp</dimen>
    <dimen name="radio_seek_size">52dp</dimen>
    <dimen name="radio_preset_height">48dp</dimen>
    <dimen name="radio_preset_text">16sp</dimen>

    <!-- [3] + [4] map portal and speed HUD -->
    <dimen name="map_bezel_width">30dp</dimen>
    <dimen name="map_vehicle_size">30dp</dimen>
    <dimen name="map_hud_inset">22dp</dimen>
    <dimen name="map_button_size">52dp</dimen>
    <dimen name="speed_text">88sp</dimen>
    <dimen name="speed_unit_text">18sp</dimen>
    <dimen name="cardinal_text">24sp</dimen>
    <dimen name="degrees_text">16sp</dimen>

    <!-- [5] + [6] tiles -->
    <dimen name="card_label_text">18sp</dimen>
    <dimen name="card_sub_text">13sp</dimen>
    <dimen name="card_icon">40dp</dimen>
    <dimen name="card_icon_large">52dp</dimen>

    <!-- [7] + [8] docks -->
    <dimen name="dock_height">64dp</dimen>
    <dimen name="dock_icon">36dp</dimen>
    <dimen name="dock_item_width">56dp</dimen>
    <dimen name="badge_size">12dp</dimen>

    <!-- The rasterisation size for cached launcher icons. -->
    <dimen name="app_icon_size">56dp</dimen>
    <dimen name="app_label_text">12sp</dimen>
    <dimen name="app_grid_item_height">104dp</dimen>
    <dimen name="app_grid_spacing">6dp</dimen>

    <dimen name="search_text">18sp</dimen>
    <dimen name="picker_icon">40dp</dimen>
    <dimen name="picker_label_text">17sp</dimen>

    <!-- Map search, pins and navigation card -->
    <dimen name="map_pin_size">40dp</dimen>
    <dimen name="map_card_side_margin">24dp</dimen>
    <dimen name="place_row_min_height">64dp</dimen>
    <dimen name="place_title_text">17sp</dimen>
    <dimen name="place_subtitle_text">13sp</dimen>
    <dimen name="nav_glyph_text">40sp</dimen>
    <dimen name="nav_title_text">26sp</dimen>
    <dimen name="nav_subtitle_text">15sp</dimen>
    <dimen name="nav_button_height">48dp</dimen>
</resources>
