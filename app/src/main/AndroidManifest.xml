<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Updater only. Everything else works with zero connectivity. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- GPS speed + bearing. COARSE must also be declared or the API 31+ runtime dialog rejects
         a FINE-only request. No BACKGROUND_LOCATION: we only read location while visible. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Sideloading the downloaded update APK. Still gated by the per-app "install unknown apps"
         op, checked at runtime via PackageManager.canRequestPackageInstalls(). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Head units routinely lack GPS hardware flags, a magnetometer, or both. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Package visibility (API 30+, applied by targetSdk not device version).
         Without this the app drawer is EMPTY and every getLaunchIntentForPackage() returns null. -->
    <queries>
        <!-- (a) Every app that has a launcher icon - exactly what the drawer needs. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!-- Suggested-app sections in the nav / music pickers. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>

        <!-- So the package installer is resolvable for the update APK. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>

        <!-- (b) Phone-projection adapters listed explicitly: several of these ship with NO
             launcher activity (the stock shell starts them), so the MAIN/LAUNCHER intent
             query above would not make them visible.
             TODO: verify per head unit with `adb shell pm list packages | grep -i link`. -->
        <package android:name="com.zjinglink.zlink" />
        <package android:name="com.carlinkit.zlink" />
        <package android:name="cn.manstep.phonemirror" />
        <package android:name="com.autokit.carplay" />
        <package android:name="com.carbit.autokit" />
        <package android:name="com.autokit.link" />
        <package android:name="net.easyconn" />
        <package android:name="net.easyconn.carman" />
        <package android:name="com.hur.headunit" />
        <package android:name="com.hur.reloaded" />
    </queries>

    <application
        android:name=".CarLauncherApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarLauncher">

        <activity
            android:name=".ui.HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboardHidden|keyboard|navigation|screenSize|screenLayout|smallestScreenSize|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.CarLauncher.Home"
            android:windowSoftInputMode="adjustNothing">

            <!-- MAIN + HOME + DEFAULT is what makes this selectable as the Home app.
                 DEFAULT is mandatory (HOME dispatch is an implicit intent).
                 LAUNCHER is kept so it can be opened like a normal app while testing. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MONKEY" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
